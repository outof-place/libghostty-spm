+test "SlidingWindow single append match case" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var w: SlidingWindow = try .init(alloc, .forward, "\x01Boo!");
+    defer w.deinit();
+    try testing.expect(w.match_case);
+    try testing.expectEqualStrings("Boo!", w.pattern);
+
+    var s = try Screen.init(io, alloc, .{ .cols = 80, .rows = 24, .max_scrollback_bytes = 0 });
+    defer s.deinit();
+    try s.testWriteString("hello. boo! hello. Boo!");
+    _ = try w.append(s.pages.pages.first.?);
+
+    // Only the match in the same case.
+    {
+        const h = w.next().?;
+        const sel = h.untracked();
+        try testing.expectEqual(point.Point{ .active = .{
+            .x = 19,
+            .y = 0,
+        } }, s.pages.pointFromPin(.active, sel.start));
+        try testing.expectEqual(point.Point{ .active = .{
+            .x = 22,
+            .y = 0,
+        } }, s.pages.pointFromPin(.active, sel.end));
+    }
+    try testing.expect(w.next() == null);
+}
+
+test "SlidingWindow single append match case reversed" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var w: SlidingWindow = try .init(alloc, .reverse, "\x01Boo!");
+    defer w.deinit();
+    try testing.expectEqualStrings("!ooB", w.pattern);
+
+    var s = try Screen.init(io, alloc, .{ .cols = 80, .rows = 24, .max_scrollback_bytes = 0 });
+    defer s.deinit();
+    try s.testWriteString("hello. Boo! hello. boo!");
+    _ = try w.append(s.pages.pages.first.?);
+
+    {
+        const h = w.next().?;
+        const sel = h.untracked();
+        try testing.expectEqual(point.Point{ .active = .{
+            .x = 7,
+            .y = 0,
+        } }, s.pages.pointFromPin(.active, sel.start).?);
+        try testing.expectEqual(point.Point{ .active = .{
+            .x = 10,
+            .y = 0,
+        } }, s.pages.pointFromPin(.active, sel.end).?);
+    }
+    try testing.expect(w.next() == null);
+}
